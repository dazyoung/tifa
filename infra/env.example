# Copy to infra/.env (gitignored) and fill in. Placeholders only: never commit real values.
# Read by infra/bootstrap.sh, infra/first-deploy.sh and infra/post-deploy.sh, which refuse to run without it.
# They read this file only: the same names exported in your shell are ignored, so a project set for other work is
# never used by mistake. Unknown names are an error. Resource names are not settings: they are fixed in
# infra/lib.sh and all start with tifa-.

# The existing Google Cloud project Tifa runs in (it may host other services; Tifa leaves them alone).
GCP_PROJECT_ID=your-project-id
# Region for Cloud Run, Artifact Registry and Cloud Scheduler.
GCP_REGION=europe-west1
# Location for the (default) Firestore database, used only when the project has none yet. Fixed once created.
FIRESTORE_LOCATION=europe-west1

# The GitHub repository allowed to deploy (owner/repo), and its owner's numeric ID:
#   gh api repos/OWNER/REPO --jq .owner.id
GITHUB_REPOSITORY=owner/repo
GITHUB_REPOSITORY_OWNER_ID=000000

# Budget (post-deploy.sh). It counts only resources labelled app=tifa in this project. The currency must be the
# billing account's currency.
BILLING_ACCOUNT_ID=XXXXXX-XXXXXX-XXXXXX
BUDGET_AMOUNT=3.75
BUDGET_CURRENCY=GBP

# Deploy settings for infra/first-deploy.sh. Keep them the same as the GitHub repository variables of the same
# names, which every later deploy uses. Defaults shown.
# Secret version of the TfL app key (empty: the poller calls TfL anonymously).
TFL_APP_KEY_VERSION=
# Sources the API publishes: a (Tifa's own recording). Add f (TfL's FOI release) only with TfL's permission to
# re-use that data, which it has not given.
TIFA_PUBLIC_SOURCES=a
# Extra host names (custom domains) the MCP endpoint accepts, comma-separated.
TIFA_ALLOWED_HOSTS=
# all, or internal to hide the poller from the internet as well (IAM keeps it private either way).
TIFA_POLLER_INGRESS=all
