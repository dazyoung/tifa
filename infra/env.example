# Copy to infra/.env (gitignored) and fill in. Placeholders only: never commit real values.
# Read by infra/bootstrap.sh and infra/post-deploy.sh. Values in the environment override this file.

# Google Cloud project that runs Tifa (create it and link a billing account first).
GCP_PROJECT_ID=your-project-id
# Region for Cloud Run, Artifact Registry and Cloud Scheduler.
GCP_REGION=europe-west1
# Firestore location (a region such as europe-west1, or a multi-region such as eur3). Fixed once created.
FIRESTORE_LOCATION=europe-west1

# The GitHub repository allowed to deploy, and its owner's numeric ID:
#   gh api repos/OWNER/REPO --jq .owner.id
GITHUB_REPOSITORY=owner/repo
GITHUB_REPOSITORY_OWNER_ID=000000

# Budget (post-deploy.sh). The currency must be the billing account's currency.
BILLING_ACCOUNT_ID=XXXXXX-XXXXXX-XXXXXX
BUDGET_AMOUNT=3.75
BUDGET_CURRENCY=GBP

# Optional overrides (defaults shown).
# AR_REPOSITORY=tifa
# API_SERVICE=tifa-api
# POLLER_SERVICE=tifa-poller
# SCHEDULER_JOB=tifa-poll
# WIF_POOL=github
# WIF_PROVIDER=github-actions
# BUDGET_NAME=tifa
