    "/v1/stats": {
      "get": {
        "description": "Good service, unplanned and planned disruptions, line-time disrupted, the most disrupted line, the\nlongest unplanned disruption, the busiest day, the top causes, chart bins and one row per line, against\nthe period before when both were watched enough. Shares are 0-1, times epoch seconds.",
        "operationId": "stats_v1_stats_get",
        "parameters": [
          {
            "description": "1d, 7d, 30d, 90d or 365d (default 7d).",
            "in": "query",
            "name": "span",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "1d, 7d, 30d, 90d or 365d (default 7d).",
              "title": "Span"
            }
          },
          {
