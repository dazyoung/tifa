    "/healthz": {
      "get": {
        "description": "The last poll and its age, the guard's heartbeat and the TfL key state. 503 when the last poll is\nmore than 10 minutes old.",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            },
            "description": "The data, in the envelope"
          },
          "304": {
            "description": "Not modified (If-None-Match matched the ETag)"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Too many requests from this client (Retry-After)"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Service health",
        "tags": [
          "about"
        ]
      }
    },
    "/v1/changes": {
      "get": {
        "description": "For keeping a copy in sync: the status now, the open episodes, the episodes that closed at or after\n`since` (an episode closed at a gap ends at the poll before it, so repeats can come: merge on line,\nseverity, planned and start), the poll times after `since` and the next `cursor`. 410 when `since` is\nmore than 35 days ago: reload the months instead.",
        "operationId": "changes_v1_changes_get",
        "parameters": [
          {
            "description": "Epoch seconds: the `cursor` of the previous answer (at most 35 days ago).",
            "in": "query",
            "name": "since",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Epoch seconds: the `cursor` of the previous answer (at most 35 days ago).",
              "title": "Since"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            },
            "description": "The data, in the envelope"
          },
          "304": {
            "description": "Not modified (If-None-Match matched the ETag)"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Bad request"
          },
          "410": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "The cursor is too old"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Too many requests from this client (Retry-After)"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "The service is at a limit, or the store cannot be read (Retry-After)"
          }
        },
        "summary": "What changed since a cursor",
        "tags": [
          "live"
        ]
      }
    },
